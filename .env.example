# Clé de l'API Claude (https://console.anthropic.com). Sans clé, Oriah Elle fonctionne en mode hors ligne
# (réponses préparées, détection du danger et annuaire restent actifs).
ANTHROPIC_API_KEY=

# Modèle utilisé par Elle. Par défaut : claude-opus-5-5.
# claude-haiku-5-5 coûte environ 40 fois moins cher ; à évaluer sur des conversations de test avant de changer.
ORIAH_ELLE_MODEL=claude-opus-5-5

# Profondeur de réflexion : low | medium | high. Par défaut : medium.
ORIAH_ELLE_EFFORT=medium
